<style>
.chatbot-button,
.chatbot-container {
    --chatbot-primary: {{ settings.primaryColor }};
    --chatbot-user-msg: {{ settings.primaryColor }};
    --chatbot-logo-bg: {{ settings.logoBgColor }};
}
</style>
<script>
var ChatbotConfig = {
    apiUrl: '{{ siteUrl("chatbot/message") }}',
    rateUrl: '{{ siteUrl("chatbot/rate") }}',
    csrfTokenName: '{{ csrfTokenName }}',
    csrfTokenValue: '{{ csrfTokenValue }}',
    companyName: {{ settings.companyName | json_encode | raw }},
    logoText: {{ settings.logoText | json_encode | raw }},
    logoUrl: {{ logoUrl | json_encode | raw }},
    primaryColor: {{ settings.primaryColor | json_encode | raw }},
    initialMessage: {{ settings.initialMessage | json_encode | raw }},
    defaultTheme: {{ settings.defaultTheme | json_encode | raw }},
    inputPlaceholder: {{ settings.inputPlaceholder | default('Your message...') | json_encode | raw }},
    sendButtonText: {{ settings.sendButtonText | default('Send') | json_encode | raw }},
    enableRatings: {{ settings.enableRatings ? 'true' : 'false' }},
    suggestionsEnabled: {{ settings.suggestionsEnabled ?? true ? 'true' : 'false' }},
    suggestions: {{ settings.suggestions | default([]) | json_encode | raw }},
    iconChat: {{ settings.iconChat | default('fas fa-comments') | json_encode | raw }},
    iconThumbUp: {{ settings.iconThumbUp | default('fas fa-thumbs-up') | json_encode | raw }},
    iconThumbDown: {{ settings.iconThumbDown | default('fas fa-thumbs-down') | json_encode | raw }},
    iconClose: {{ settings.iconClose | default('fas fa-times') | json_encode | raw }},
    iconNewChat: {{ settings.iconNewChat | default('fas fa-sync-alt') | json_encode | raw }},
    iconThemeLight: {{ settings.iconThemeLight | default('fas fa-moon') | json_encode | raw }},
    iconThemeDark: {{ settings.iconThemeDark | default('fas fa-sun') | json_encode | raw }}
};
</script>
